{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Executar Programa",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/projeto_biblioeca",
            "args": ["entrada.txt", "saida.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true
            }
        }
    ]
}
